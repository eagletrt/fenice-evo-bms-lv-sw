'''
Most of the rules have been generalized for any "depth"
meaning that any file, even if not at the root level, is ignored
'''

# Created by GITIGNORE.IO https://www.toptal.com/developers/gitignore/

### C ###
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
# not needed for embedded projects
'''
*.dll
*.so
*.so.*
*.dylib
'''

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
# not needed for embedded projects
'''
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
'''

